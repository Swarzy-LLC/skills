amends "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["oxfmt"] = (Builtins.oxfmt) {
    prefix = List("bun", "run", "--bun")
    glob = List("**/*.md", "**/*.ts", "**/*.json")
  }
  ["skill-frontmatter"] {
    glob = List("skills/**/SKILL.md", "scripts/check-skill-frontmatter.ts")
    check = "bun scripts/check-skill-frontmatter.ts"
  }
}

local checks = (linters) {
  ["typecheck"] {
    glob = List("**/*.ts", "tsconfig.json", "package.json")
    depends = List("oxfmt")
    check = "bun check"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = checks
  }
  ["pre-push"] {
    steps = checks
  }
  ["check"] {
    steps = checks
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
